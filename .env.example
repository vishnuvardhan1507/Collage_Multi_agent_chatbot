GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b
COLLEGE_TIMEZONE=Asia/Kolkata
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes_long
DATABASE_PATH=./backend/db/college.db
CHROMA_PERSIST_DIR=./backend/chroma_store
RAG_USE_CHROMA=1
ALLOW_MODEL_DOWNLOAD=1

# Gmail SMTP: use a Google app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME.
SMTP_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:5173
